# syntax=docker/dockerfile:1
#
# herdr control-plane image.
#
# IMPORTANT: herdr spawns pane child processes INSIDE THIS CONTAINER'S OWN
# filesystem/toolchain, not inside the `pi` container. Panes driven from
# roamgate therefore need pi/git/gh/kubectl/bash available HERE — this image
# intentionally duplicates the pi image's toolchain (Docker layer caching
# de-duplicates identical layers on disk; see README.md "Shared toolchain").
FROM node:24-alpine AS herdr

ARG PUID=1000
ARG PGID=1000
ARG GH_VERSION=2.101.0
ARG KUBECTL_VERSION=v1.37.0
ARG HERDR_VERSION=0.9.1
ARG PI_PACKAGE_VERSION=0.87.0
ARG WORKTRUNK_VERSION=0.79.0
ARG HERDR_SHA256_AMD64=2a02fed16beb651ef006e1d43f048f652ca4dc58ad053cd2d44450563d5c54b7
ARG HERDR_SHA256_ARM64=f4ccf4de745f2cb9a39a983e9ba3703dad50ec2a58dea83026ceab721bbd8d9e
ARG TARGETARCH

LABEL org.opencontainers.image.title="pi-roamgate-docker / herdr" \
      org.opencontainers.image.description="herdr control plane, packaged with the pi coding agent + gh + kubectl + worktrunk toolchain for pane child processes" \
      org.opencontainers.image.licenses="Apache-2.0 AND MIT AND (MIT OR Apache-2.0)" \
      org.opencontainers.image.source="https://github.com/herdrdev/herdr"

COPY docker/lib/create-user.sh /usr/local/lib/herdr-docker/create-user.sh
COPY docker/lib/install-toolchain.sh /usr/local/lib/herdr-docker/install-toolchain.sh
COPY docker/lib/install-herdr.sh /usr/local/lib/herdr-docker/install-herdr.sh
COPY docker/lib/install-pi.sh /usr/local/lib/herdr-docker/install-pi.sh
COPY docker/lib/install-worktrunk.sh /usr/local/lib/herdr-docker/install-worktrunk.sh
COPY docker/lib/wait-for-herdr-socket.sh /usr/local/lib/herdr-docker/wait-for-herdr-socket.sh
RUN chmod +x /usr/local/lib/herdr-docker/*.sh

# All docker/lib/*.sh scripts have a #!/bin/bash shebang, but Alpine's
# node:*-alpine has no bash until install-toolchain.sh installs it -- and
# that script IS one of the #!/bin/bash scripts. Break the chicken-and-egg
# with a minimal bash-only install here, via Docker's default /bin/sh
# (Alpine's ash, always present), before executing anything with a bash
# shebang.
RUN apk add --no-cache bash

# install-toolchain.sh MUST run before create-user.sh: unlike Debian's
# node:*-bookworm-slim, Alpine's node:*-alpine ships neither bash nor GNU
# shadow-utils (useradd/groupadd/usermod/groupmod/getent) by default —
# create-user.sh needs all of those, provided by the `shadow`+`bash`+
# `coreutils` apk packages installed inside install-toolchain.sh.
RUN /usr/local/lib/herdr-docker/install-toolchain.sh "${TARGETARCH}" "${GH_VERSION}" "${KUBECTL_VERSION}"
RUN /usr/local/lib/herdr-docker/create-user.sh herdr herdr "${PUID}" "${PGID}" /home/herdr
RUN /usr/local/lib/herdr-docker/install-herdr.sh "${HERDR_VERSION}" "${TARGETARCH}" "${HERDR_SHA256_AMD64}" "${HERDR_SHA256_ARM64}"
RUN /usr/local/lib/herdr-docker/install-pi.sh "${PI_PACKAGE_VERSION}"
RUN /usr/local/lib/herdr-docker/install-worktrunk.sh "${WORKTRUNK_VERSION}" "${TARGETARCH}"

COPY docker/herdr-entrypoint.sh /usr/local/bin/herdr-entrypoint.sh
RUN chmod +x /usr/local/bin/herdr-entrypoint.sh

# Pre-create every volume mountpoint at build time, owned by the target
# user, so a fresh named Docker volume inherits this ownership on first
# mount (local-driver copy-up semantics) — no runtime chown ever needed.
RUN mkdir -p /run/herdr /home/herdr/.config/herdr /home/herdr/.pi/agent /workspace \
    && chmod 0700 /run/herdr \
    && chown -R "${PUID}:${PGID}" /run/herdr /home/herdr /workspace

USER herdr:herdr
WORKDIR /workspace
ENV HOME=/home/herdr
# herdr spawns pane child processes using $SHELL; without this it falls
# back to /bin/sh. The herdr user's passwd shell is already /bin/bash (see
# create-user.sh), but $SHELL isn't inherited from that unless set here.
ENV SHELL=/bin/bash

HEALTHCHECK --interval=5s --timeout=3s --start-period=10s --retries=6 \
  CMD test -S /run/herdr/herdr.sock && test -S /run/herdr/herdr-client.sock

ENTRYPOINT ["/usr/local/bin/herdr-entrypoint.sh"]
CMD []
