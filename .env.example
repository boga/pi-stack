# Copy to .env and adjust. See README.md before changing PUID/PGID on an
# existing deployment — they are effectively FIXED once volumes exist.

# ---------------------------------------------------------------------------
# UID/GID baked into all three images at build time. Must be identical
# across all three services (herdr writes /run/herdr rw, pi/roamgate read
# it ro). Do NOT change these after `docker compose up` has created named
# volumes without following the migration procedure in README.md —
# "Changing PUID/PGID after first run".
PUID=1000
PGID=1000

# Host directory bind-mounted at /workspace in all three containers (herdr,
# pi, roamgate) at the identical absolute path. Relative paths are resolved
# against this file's directory. Defaults to ./workspace if unset.
WORKSPACE_DIR=./workspace

# ---------------------------------------------------------------------------
# roamgate network binding. Internal HOST is always 0.0.0.0 (required for
# Docker port forwarding to reach it); these two control the HOST-side
# publish address/port only.
ROAMGATE_BIND_ADDRESS=127.0.0.1
ROAMGATE_HOST_PORT=8787

# REQUIRED. roamgate binds non-loopback internally (HOST=0.0.0.0), which
# makes auth mandatory. Compose will refuse to start without this set.
ROAMGATE_PASSWORD=change-me-to-a-real-secret

# ---------------------------------------------------------------------------
# Bounded socket-wait timeout (seconds) used by pi/roamgate entrypoints
# while polling for herdr's Unix sockets to appear.
HERDR_WAIT_TIMEOUT=60

# ---------------------------------------------------------------------------
# Version pins (build args). Changing these changes what gets baked into
# the images on next `docker compose build`.
HERDR_VERSION=0.9.1
ROAMGATE_VERSION=0.7.8
PI_PACKAGE_VERSION=0.87.0
GH_VERSION=2.101.0
KUBECTL_VERSION=v1.37.0
WORKTRUNK_VERSION=0.79.0

# roamgate build target: "runtime" (native-arch, default, runs a build-time
# smoke test) or "runtime-cross" (cross-arch via buildx, checksum-only,
# never executes the binary during build).
ROAMGATE_BUILD_TARGET=runtime

# ---------------------------------------------------------------------------
# NOTE on HERDR_ENV: this variable is meant to be injected by herdr into
# real pane child processes, along with a truthful HERDR_PANE_ID. The
# standalone `pi` container in this stack cannot supply a truthful pane id,
# so it is deliberately left UNSET rather than faked. Do not set it here.
